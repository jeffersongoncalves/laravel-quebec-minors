{
    "name": "jeffersongoncalves/laravel-quebec-minors",
    "description": "Minors under Quebec Law 25: consent of the person having parental authority under 14 (ss. 4.1 and 14), age assurance, guardian links and an adult-only middleware",
    "keywords": [
        "laravel",
        "privacy",
        "quebec",
        "law-25",
        "minors",
        "age-verification",
        "parental-consent"
    ],
    "homepage": "https://github.com/jeffersongoncalves/laravel-quebec-minors",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Jefferson Simão Gonçalves",
            "email": "gerson.simao.92@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "spatie/laravel-package-tools": "^1.16",
        "illuminate/contracts": "^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.24",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "JeffersonGoncalves\\QuebecMinors\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JeffersonGoncalves\\QuebecMinors\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "JeffersonGoncalves\\QuebecMinors\\QuebecMinorsServiceProvider"
            ],
            "aliases": {
                "QuebecMinors": "JeffersonGoncalves\\QuebecMinors\\Facades\\QuebecMinors"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
